# AppArmor profile for hajiz
#
# Allows hajiz to create unprivileged user namespaces on Ubuntu 23.10+
# (where kernel.apparmor_restrict_unprivileged_userns=1 by default).
#
# Installation:
#   sudo cp packaging/apparmor/hajiz /etc/apparmor.d/hajiz
#   sudo apparmor_parser -r /etc/apparmor.d/hajiz
#   # or: sudo systemctl reload apparmor
#
# Uninstallation:
#   sudo rm /etc/apparmor.d/hajiz
#   sudo systemctl reload apparmor
#
# This profile follows the bwrap-userns-restrict (Bubblewrap) model:
# the (unconfined) flag indicates that hajiz is not restricted by AppArmor
# beyond the explicit `userns,` permission it needs. The real sandbox
# security comes from seccomp + Landlock + namespaces applied by hajiz
# itself to the child process, not from AppArmor.

abi <abi/4.0>,

include <tunables/global>

profile hajiz /usr/{,local/}bin/hajiz flags=(unconfined) {
  userns,

  # Allows local administrators to add site-specific rules without editing
  # this file (e.g. an alternative installation path).
  include if exists <local/hajiz>
}
